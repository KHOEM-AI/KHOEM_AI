{
  "name": "@khoem-ai/localization",
  "version": "0.1.0",
  "description": "KHOEM_AI: central language & localization infrastructure",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "node": ">=20" },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" }
  },
  "files": ["dist/src", "README.md", "CHANGELOG.md"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "validate:locales": "npm run build && node dist/scripts/validate-locales.js",
    "check:duplicates": "npm run build && node dist/scripts/check-duplicates.js",
    "report:translations": "npm run build && node dist/scripts/translation-report.js",
    "verify": "npm run build && node dist/scripts/check-duplicates.js && node dist/scripts/validate-locales.js && node --test dist/tests/*.test.js && node dist/scripts/translation-report.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
